{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MCPStartStopOnlyTaggedInstances",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances",
        "ec2:StopInstances"
      ],
      "Resource": "arn:aws:ec2:*:*:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/MCPManaged": "true"
        }
      }
    }
  ]
}
