# =============================================================
#  Copy to .env and fill in:   cp .env.example .env && nano .env
#  docker-compose.yml passes each value ONLY to the container
#  that needs it. Keep comments on their own lines.
# =============================================================

# ---------- LLM (agent container) ----------
# Anthropic: anthropic:claude-sonnet-5  |  anthropic:claude-haiku-4-5-20251001
# OpenAI:    openai:gpt-4o-mini
LLM_MODEL=anthropic:claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------- Jira Cloud (jira container) ----------
# Token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# ---------- AWS (ec2 container) ----------
# Credentials come from the EC2 IAM role. Never put access keys here.
AWS_REGION=ap-south-1
EC2_ALLOW_WRITE=false

# ---------- GitHub (github container) ----------
# Optional. Empty = 60 requests/hour. A token with NO scopes = 5,000/hour.
# https://github.com/settings/tokens
GITHUB_TOKEN=

# ---------- Wikipedia (wikipedia container) ----------
# Wikimedia asks for a descriptive User-Agent with a contact.
WIKIPEDIA_USER_AGENT=mcp-langchain-lab/1.0 (training project; contact: you@example.com)

# Weather and Currency need no keys.
